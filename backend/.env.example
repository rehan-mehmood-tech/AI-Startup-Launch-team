SERPAPI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Dedicated per-agent Groq key (Agent 2: Product Strategist) — distributes the
# 8000 TPM rate limit across a separate account instead of sharing GROQ_API_KEY.
# Falls back to GROQ_API_KEY when left blank.
GROQ_PRODUCT_STRATEGIST_API_KEY=

# Dedicated per-agent Groq key (Agent 3: Pricing) — same rationale as above.
# Falls back to GROQ_API_KEY when left blank.
GROQ_PRICING_AGENT_API_KEY=

# Dedicated per-agent Groq key (Agent 4: Marketing) — same rationale as above.
# Falls back to GROQ_API_KEY when left blank.
GROQ_MARKETING_AGENT_API_KEY=

# Dedicated per-agent Groq key (Agent 5: Chief AI Orchestrator) — same rationale as above.
# Falls back to GROQ_API_KEY when left blank.
GROQ_ORCHESTRATOR_AGENT_API_KEY=

# SerpApi execution layer (PRD §2.3: 3 attempts, exponential backoff from 2s)
SERPAPI_TIMEOUT_SECONDS=20
SERPAPI_MAX_ATTEMPTS=3
SERPAPI_BACKOFF_BASE_SECONDS=2
SERPAPI_MAX_WORKERS=6

# Supabase — Postgres persistence + auth. See database_schema.sql for the schema.
# service_role bypasses Row Level Security: backend-only, never ship to a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# anon_key is safe to expose to a browser/frontend context.
SUPABASE_ANON_KEY=
