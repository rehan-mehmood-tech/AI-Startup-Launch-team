# Safe to expose to the browser — Supabase's anon key + RLS policies (see
# backend/database_schema.sql) are what keep data private, not this key's secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The FastAPI backend's base URL.
NEXT_PUBLIC_BACKEND_BASE_URL=http://127.0.0.1:8000
